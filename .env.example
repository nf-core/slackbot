# Slack App credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token  # Socket mode (local dev)

# GitHub (fine-grained PAT with read:org scope)
GITHUB_TOKEN=ghp_your-token
GITHUB_ORG=nf-core

# DynamoDB
DYNAMODB_TABLE=nf-core-bot
DYNAMODB_ENDPOINT=http://localhost:8000  # local DynamoDB; unset for AWS
AWS_REGION=eu-west-1

# Permissions
CORE_TEAM_USERGROUP_HANDLE=core-team
MAINTAINERS_USERGROUP_HANDLE=maintainers-team

# Pipeline-proposal reviews (Claude via AWS Bedrock)
PROPOSALS_CHANNEL=new-pipelines
PROPOSALS_REVIEW_ENABLED=true
# Bedrock inference-profile ID (note the eu. prefix for eu-west-1)
BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-8
# BEDROCK_REGION=eu-west-1          # defaults to AWS_REGION
# BEDROCK_THINKING=adaptive         # or "off"
# Optional read-only GitHub token for the review tool (falls back to GITHUB_TOKEN)
# PROPOSALS_GITHUB_TOKEN=ghp_readonly-token
